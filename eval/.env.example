# 评测配置模板：复制为 eval/.env 后填写。
#   PowerShell:  Copy-Item eval\.env.example eval\.env
#   bash:        cp eval/.env.example eval/.env
# eval/.env 已被 .gitignore 忽略，密钥不会被提交。
# 已经在终端里设置过的同名环境变量优先于这里的值。

# ── 必填 ────────────────────────────────────────────────
EVAL_API_KEY=sk-your-key-here

# ── 模型（默认 DeepSeek）─────────────────────────────────
EVAL_ENDPOINT=openai
EVAL_MODEL=deepseek-flash
EVAL_API_BASE=https://api.deepseek.com

# 通义千问（DashScope 兼容模式）：
# EVAL_MODEL=qwen-plus
# EVAL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI：
# EVAL_MODEL=gpt-4.1-mini
# EVAL_API_BASE=

# ── 可选：运行参数 ───────────────────────────────────────
# EVAL_JOBS=3
# EVAL_REPEAT=2
# EVAL_TIMEOUT=600
# EVAL_NO_JUDGE=1

# ── 可选：上传到 LangSmith 对比（eval\eval.ps1 upload / -LangSmith）─────
# LANGSMITH_API_KEY=lsv2_...
# EVAL_LANGSMITH=1                     # 每次跑完自动上传
# EVAL_LANGSMITH_DATASET=alidade-eval
